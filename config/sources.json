        ]
      },
      {
        "id": "exports",
        "flow": "X",
        "label": "관세번호·국가별 수출",
        "urls": [
          "https://ocean.bazg.admin.ch/open-data-reports/TN8_EXP_en/TN8_EXP_en.zip",
          "https://ocean.nivel.bazg.admin.ch/open-data-reports/TN8_EXP_en/TN8_EXP_en.zip",
          "https://ocean.bazg.admin.ch/open-data-reports/TN8_EXP_en/TN8_EXP_en.csv",
