          "https://ocean.bazg.admin.ch/open-data-reports/TN8_IMP_en/TN8_IMP_en.zip",
          "https://ocean.nivel.bazg.admin.ch/open-data-reports/TN8_IMP_en/TN8_IMP_en.zip",
          "https://ocean.bazg.admin.ch/open-data-reports/TN8_IMP_en/TN8_IMP_en.csv",
