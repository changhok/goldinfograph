{
  "_설명": "수집 범위와 출처 주소를 한곳에서 관리하는 설정 파일. 코드 수정 없이 이 파일만 고치면 된다. 자세한 설명은 README.md 참고.",

  "start_year": 2000,

  "comtrade": {
    "_설명": "UN Comtrade. 키가 있으면(저장소 Secret COMTRADE_API_KEY) 전 세계 전체를, 없으면 무료 미리보기로 주요국 최근 자료만 수집한다.",
    "base_url": "https://comtradeapi.un.org",
    "commodity_codes": ["7108", "710811", "710812", "710813", "710820"],
    "flows": ["M", "X"],
    "request_pause_seconds": 1.3,
    "max_minutes_per_run": 100,
    "key_mode": {
      "calls_per_run": 400,
      "records_per_call_cap": 100000,
      "refresh_recent_months": 24,
      "refresh_after_days": 25,
      "refresh_old_after_days": 365
    },
    "preview_mode": {
      "calls_per_run": 400,
      "records_per_call_cap": 500,
      "request_pause_seconds": 2.5,
      "reporters_per_call": 4,
      "recent_months": 24,
      "commodity_codes": ["7108"],
      "reporters_iso3": [
        "CHE", "GBR", "ARE", "HKG", "CHN", "IND", "USA", "SGP", "TUR", "THA",
        "DEU", "ITA", "FRA", "CAN", "AUS", "ZAF", "JPN", "KOR", "RUS", "KAZ",
        "UZB", "MEX", "PER", "BRA", "GHA", "MLI", "IDN", "SAU", "POL", "AUT"
      ]
    }
  },

  "swiss": {
